# Copy to .env. Docker Compose reads it automatically, and so do the tests and `cargo sqlx`.

POSTGRES_USER=routeforge
POSTGRES_PASSWORD=routeforge
POSTGRES_DB=routeforge
POSTGRES_PORT=5432

# Must match the four values above.
# 127.0.0.1, not localhost: on Windows with Docker Desktop, localhost resolves to ::1 first,
# and a connection to the published port hangs there for about 20 seconds before the client
# falls back to IPv4. Every test and every pooled connection would pay that.
DATABASE_URL=postgres://routeforge:routeforge@127.0.0.1:5432/routeforge
