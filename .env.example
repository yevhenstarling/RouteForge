# Copy to .env. Docker Compose reads it automatically, and so do the tests and `cargo sqlx`.

POSTGRES_USER=routeforge
POSTGRES_PASSWORD=routeforge
POSTGRES_DB=routeforge
POSTGRES_PORT=5432

# Must match the four values above.
# 127.0.0.1, not localhost: on Windows with Docker Desktop, localhost resolves to ::1 first,
# and a connection to the published port hangs there for about 20 seconds before the client
# falls back to IPv4. Every test and every pooled connection would pay that.
DATABASE_URL=postgres://routeforge:routeforge@127.0.0.1:5432/routeforge

# The solver's settings, shown with their defaults. Docker Compose passes the ones that
# are set here on to every solver instance. A solver that runs outside Docker reads
# them, and DATABASE_URL, from its own environment.
#
# Workers in one process. Scaling is by instances: docker compose up --scale solver=4
#SOLVER_CONCURRENCY=1
# How long a claim holds without a heartbeat. The job of a worker that dies is taken
# over this long after its last one.
#SOLVER_LEASE_SECS=30
# How often a running job extends its lease, which is also how soon a cancelled plan
# stops its searches. At most half the lease.
#SOLVER_HEARTBEAT_SECS=5
# How often an idle worker looks at the queue without having been notified.
#SOLVER_POLL_SECS=5
# How often, at most, a route search announces how far it has got and with which
# route, in milliseconds. This is how often a line on the map moves.
#SOLVER_PROGRESS_MS=250
# `json` for one JSON object per line. The API reads these two as well.
#LOG_FORMAT=text
#RUST_LOG=info

# The API's settings. It has no compose service before Phase 6 and runs on the host,
# where it reads them, and DATABASE_URL, from its own environment. It does not read
# .env. CLAUDE.md shows how to set them in a shell.
#
# The key that signs the login tokens. Required, at least 32 bytes, and there is no
# default: whoever has it can sign a token for any user and role.
#JWT_SECRET=
# The admin to make when the API starts, if no account has that address yet. Both or
# neither. An account that is there is left as it is, its password included.
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=
# Shown with their defaults:
#
# The address and port to listen on.
#API_BIND=127.0.0.1:8080
# How long a login is good for. A role that an admin changes applies from the user's
# next login.
#JWT_TTL_SECS=3600
# The time each route of a plan may be searched for when the plan asks for no budget,
# and the most a plan may ask for: of time, and of candidate moves.
#API_BUDGET_DEFAULT_MS=10000
#API_BUDGET_MAX_MS=300000
#API_BUDGET_MAX_ITERATIONS=10000000000
# A worker that was seen within this long counts as alive in the stats. A few times
# SOLVER_HEARTBEAT_SECS.
#API_WORKER_ALIVE_SECS=15
