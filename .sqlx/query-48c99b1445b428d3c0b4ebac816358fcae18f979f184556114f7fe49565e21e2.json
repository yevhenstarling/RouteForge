{
  "db_name": "PostgreSQL",
  "query": "SELECT id, client_id, kind, status, service_date, lat, lon, address, demand,\n                plan_id, created_at\n         FROM orders\n         WHERE ($1::uuid IS NULL OR client_id = $1)\n           AND ($2::date IS NULL OR service_date = $2)\n           AND ($3::text IS NULL OR status = $3)\n           AND ($4::uuid IS NULL OR id > $4)\n         ORDER BY id\n         LIMIT $5",
